[Unit]
Description=Live 24/7 Canal EN — Blessed Virgin Mary
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/ao_vivo_en
ExecStart=/root/venv_en/bin/python3 /root/ao_vivo_en/ao_vivo_en.py
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

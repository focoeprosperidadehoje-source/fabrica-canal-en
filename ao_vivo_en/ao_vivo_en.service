[Unit]
Description=Live 24/7 Canal EN — Blessed Virgin Mary
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/ao_vivo_en
ExecStart=/usr/bin/python3 /root/ao_vivo_en/ao_vivo_en.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
